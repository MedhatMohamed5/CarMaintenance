    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "CarMaintenance",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "CarMaintenance (dev, offline)",
            "request": "launch",
            "type": "dart",
            "args": ["--flavor", "dev", "--no-enable-impeller"]
        },
        {
            "name": "CarMaintenance (dev, release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--flavor", "dev"]
        },
        {
            "name": "CarMaintenance (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "CarMaintenance (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}